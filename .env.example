# ==========================================================
# PL STAFF DASHBOARD — ENVIRONMENT TEMPLATE
# Copy this to .env.local and fill in your real values.
# .env.local is gitignored. NEVER commit secrets.
# ==========================================================

# ---- Supabase ----
# From Supabase dashboard: Settings → API Keys. Prefer a dedicated
# `sb_secret_...` key; this variable name is retained for app compatibility.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- JWT ----
# Generate with: `openssl rand -base64 48` (run twice, use different values)
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---- WordPress: Pitcher List ----
WP_PL_URL=https://pitcherlist.com
WP_PL_USERNAME=
WP_PL_APP_PASSWORD=

# ---- WordPress: QB List ----
WP_QB_URL=
WP_QB_USERNAME=
WP_QB_APP_PASSWORD=

# ---- Google Analytics 4 ----
# Create an OAuth 2.0 Client ID in Google Cloud Console with authorised
# redirect URI:  <NEXT_PUBLIC_APP_URL>/api/ga4/callback
# GA4_PROPERTY_ID is the numeric property ID from GA4 Admin → Property Settings
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
GA4_PROPERTY_ID=

# ---- Vercel Cron ----
# Any random string; validates incoming cron webhook calls.
CRON_SECRET=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
